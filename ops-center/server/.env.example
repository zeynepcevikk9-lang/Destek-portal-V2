# Bu dosya ÖRNEKTİR, gerçek değer içermez. Gerçek ayarlar için ".env" oluşturun (git'e girmez).
# Hiçbir parola/token bu dosyaya yazılmaz.

# --- Alarm kaynağı ---
MODE=mock                       # mock: sahte veri (varsayılan). live: gerçek Alertmanager
# SOURCES=kume-1=http://127.0.0.1:19093,kume-2=http://127.0.0.1:19094

# --- Ticket: yeni portal ---
PORTAL_MODE=local               # local: yerel kayıt. http: yeni portalın API'si
# PORTAL_URL=https://portal.ornek.invalid
# PORTAL_TOKEN=

# --- Ticket: Jira ---
JIRA_MODE=dry-run               # dry-run: Jira'ya HİÇBİR ŞEY gönderilmez (varsayılan). live: gerçek gönderim
# JIRA_BASE_URL=https://ornek.atlassian.invalid
# JIRA_EMAIL=
# JIRA_API_TOKEN=                # ortam değişkeni olarak verin, dosyaya yazıp paylaşmayın
# JIRA_PROJECT_IT=
# JIRA_PROJECT_SEC=
# JIRA_ISSUETYPE_IT=
# JIRA_ISSUETYPE_SEC=
# JIRA_PRIORITY_MAP=kritik=Highest,yuksek=High,normal=Medium
